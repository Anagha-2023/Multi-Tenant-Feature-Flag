# Environment Configuration Example
# Copy this file to .env and update with your values

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production-use-long-random-string
JWT_EXPIRES_IN=24h

# Super Admin Credentials
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=Admin@123

# CORS Configuration
CORS_ORIGIN=*

# Database Configuration (when switching from in-memory)
# DATABASE_URL=postgresql://user:password@localhost:5432/feature_flags
# MONGODB_URI=mongodb://localhost:27017/feature_flags

# API Configuration
API_PREFIX=/api
API_VERSION=v1

# Rate Limiting (for production)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Frontend URLs (for CORS in production)
# SUPER_ADMIN_URL=https://admin.example.com
# ORG_ADMIN_URL=https://app.example.com
# USER_URL=https://check.example.com
